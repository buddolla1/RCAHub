  "dataSources": {
    "ds_0_p1": {
      "type": "ds.search",
      "name": "Proxy | Pass 1 Requests",
      "options": {
        "query": "index=YOUR_INDEX (requestType=\"Proxy\" OR requestType=\"Amazon Prequal\") requestType=\"Proxy\" pass=\"1\" | stats count as Requests"
      }
    },
    "ds_0_p1_0": {
      "type": "ds.search",
      "name": "Proxy | Pass 1 Approved",
      "options": {
        "query": "index=YOUR_INDEX (requestType=\"Proxy\" OR requestType=\"Amazon Prequal\") requestType=\"Proxy\" pass=\"1\" status=\"Approved\" | stats count as Requests"
      }
    },
    "ds_0_p1_1": {
      "type": "ds.search",
      "name": "Proxy | Pass 1 Declined",
      "options": {
        "query": "index=YOUR_INDEX (requestType=\"Proxy\" OR requestType=\"Amazon Prequal\") requestType=\"Proxy\" pass=\"1\" status=\"Declined\" | stats count as Requests"
      }
    },
    "ds_0_p1_2": {
      "type": "ds.search",
      "name": "Proxy | Pass 1 Exceptions / Errored",
      "options": {
        "query": "index=YOUR_INDEX (requestType=\"Proxy\" OR requestType=\"Amazon Prequal\") requestType=\"Proxy\" pass=\"1\" status=\"Exceptions/Errored\" | stats count as Requests"
      }
    },
    "ds_0_offer": {
      "type": "ds.search",
      "name": "Proxy | Amazon Accept Offer",
      "options": {
        "query": "index=YOUR_INDEX (requestType=\"Proxy\" OR requestType=\"Amazon Prequal\") requestType=\"Proxy\" eventType=\"AMAZON_ACCEPT_OFFER\" | stats count as Offers"
      }
    },
    "ds_0_p2": {
      "type": "ds.search",
      "name": "Proxy | Pass 2 Requests",
      "options": {
        "query": "index=YOUR_INDEX (requestType=\"Proxy\" OR requestType=\"Amazon Prequal\") requestType=\"Proxy\" pass=\"2\" | stats count as Requests"
      }
    },
    "ds_0_chart": {
      "type": "ds.search",
      "name": "Proxy | Pass 1 vs Pass 2",
      "options": {
        "query": "index=YOUR_INDEX (requestType=\"Proxy\" OR requestType=\"Amazon Prequal\") requestType=\"Proxy\" | eval Stage=\"Pass \".pass | chart count over Stage by status"
      }
    },
    "ds_0_table": {
      "type": "ds.search",
      "name": "Proxy | Response Breakdown",
      "options": {
        "query": "index=YOUR_INDEX (requestType=\"Proxy\" OR requestType=\"Amazon Prequal\") requestType=\"Proxy\" | eval Stage=\"Pass \".pass | stats count as Requests by Stage status | sort Stage status"
      }
    },
    "ds_1_p1": {
      "type": "ds.search",
      "name": "Amazon Prequal | Pass 1 Requests",
      "options": {
        "query": "index=YOUR_INDEX (requestType=\"Proxy\" OR requestType=\"Amazon Prequal\") requestType=\"Amazon Prequal\" pass=\"1\" | stats count as Requests"
      }
    },
    "ds_1_p1_0": {
      "type": "ds.search",
      "name": "Amazon Prequal | Pass 1 Approved",
      "options": {
        "query": "index=YOUR_INDEX (requestType=\"Proxy\" OR requestType=\"Amazon Prequal\") requestType=\"Amazon Prequal\" pass=\"1\" status=\"Approved\" | stats count as Requests"
      }
    },
    "ds_1_p1_1": {
      "type": "ds.search",
      "name": "Amazon Prequal | Pass 1 Declined",
      "options": {
        "query": "index=YOUR_INDEX (requestType=\"Proxy\" OR requestType=\"Amazon Prequal\") requestType=\"Amazon Prequal\" pass=\"1\" status=\"Declined\" | stats count as Requests"
      }
    },
    "ds_1_p1_2": {
      "type": "ds.search",
      "name": "Amazon Prequal | Pass 1 Exceptions / Errored",
      "options": {
        "query": "index=YOUR_INDEX (requestType=\"Proxy\" OR requestType=\"Amazon Prequal\") requestType=\"Amazon Prequal\" pass=\"1\" status=\"Exceptions/Errored\" | stats count as Requests"
      }
    },
    "ds_1_offer": {
      "type": "ds.search",
      "name": "Amazon Prequal | Amazon Accept Offer",
      "options": {
        "query": "index=YOUR_INDEX (requestType=\"Proxy\" OR requestType=\"Amazon Prequal\") requestType=\"Amazon Prequal\" eventType=\"AMAZON_ACCEPT_OFFER\" | stats count as Offers"
      }
    },
    "ds_1_p2": {
      "type": "ds.search",
      "name": "Amazon Prequal | Pass 2 Requests",
      "options": {
        "query": "index=YOUR_INDEX (requestType=\"Proxy\" OR requestType=\"Amazon Prequal\") requestType=\"Amazon Prequal\" pass=\"2\" | stats count as Requests"
      }
    },
    "ds_1_chart": {
      "type": "ds.search",
      "name": "Amazon Prequal | Pass 1 vs Pass 2",
      "options": {
        "query": "index=YOUR_INDEX (requestType=\"Proxy\" OR requestType=\"Amazon Prequal\") requestType=\"Amazon Prequal\" | eval Stage=\"Pass \".pass | chart count over Stage by status"
      }
    },
    "ds_1_table": {
      "type": "ds.search",
      "name": "Amazon Prequal | Response Breakdown",
      "options": {
        "query": "index=YOUR_INDEX (requestType=\"Proxy\" OR requestType=\"Amazon Prequal\") requestType=\"Amazon Prequal\" | eval Stage=\"Pass \".pass | stats count as Requests by Stage status | sort Stage status"
      }
    },
    "ds_trend": {
      "type": "ds.search",
      "name": "Requests Over Time by Channel",
      "options": {
        "query": "index=YOUR_INDEX (requestType=\"Proxy\" OR requestType=\"Amazon Prequal\") | timechart span=1h count by requestType"
      }
    },
    "ds_errors": {
      "type": "ds.search",
      "name": "Recent Exceptions / Errored",
      "options": {
        "query": "index=YOUR_INDEX (requestType=\"Proxy\" OR requestType=\"Amazon Prequal\") status=\"Exceptions/Errored\" | table _time requestType pass status traceId errorCode message | sort -_time | head 20"
      }
    }
  },
