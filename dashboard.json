{
  "title": "Global Holiday | Proxy & Amazon Prequal",
  "description": "Pass 1 \u2192 Amazon accept offer \u2192 Pass 2; Synapps response monitoring. Requires event fields requestType, pass, status and eventType.",
  "inputs": {
    "input_time": {
      "type": "input.timerange",
      "title": "Time Range",
      "options": {
        "token": "global_time",
        "defaultValue": "-24h@h,now"
      }
    }
  },
  "defaults": {
    "dataSources": {
      "ds.search": {
        "options": {
          "queryParameters": {
            "earliest": "$global_time.earliest$",
            "latest": "$global_time.latest$"
          }
        }
      }
    }
  },
  "visualizations": {
    "viz_0_p1": {
      "type": "splunk.singlevalue",
      "title": "Proxy | Pass 1 Requests",
      "dataSources": {
        "primary": "ds_0_p1"
      },
      "options": {}
    },
    "viz_0_p1_0": {
